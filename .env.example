# 배포할 때 Vercel의 Environment Variables에 넣는 값. 이 파일에는 실제 값을 적지 않는다.

# 배포된 사이트 주소 (링크 미리보기 이미지의 기준 주소)
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Supabase: Project Settings → API 에서 복사. 두 값이 모두 있으면 Supabase에 저장하고, 없으면 개발용 파일(.data)에 저장한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 자동 삭제 정기 실행 보호용. 아무 긴 문자열이나 넣는다.
CRON_SECRET=
